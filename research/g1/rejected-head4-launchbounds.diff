+// output head for a q4 matrix with cols <= 1024 (a multi-wave kernel, so deeper per-warp load queues pay off, unlike the single-wave gate/up):
+// each warp handles R consecutive rows, issues all R weight loads before the activation staging and keeps its activation group in registers.
+// Arithmetic identical to row_dot (checked by qpack-cudadump).
+template <int WPB, int R> __global__ void __launch_bounds__(WPB * 32, QP_MINB_HD) k_head4(DMat m, MvArgs a, float *out) {
+  extern __shared__ int4 smem[];
+  const int cols = a.cols, G = cols >> 5;
+  int4 *sx = smem, *sl = smem + (cols >> 4); float *sxs = (float *)(smem + 2 * (cols >> 4)); int *sxsum = (int *)(sxs + G);
+  const int r0 = (blockIdx.x * WPB + (threadIdx.x >> 5)) * R, l = threadIdx.x & 31;
+  uint4 pv[R]; unsigned short ps[R];
+#pragma unroll
+  for (int i = 0; i < R; i++) {
+    pv[i] = make_uint4(0, 0, 0, 0); ps[i] = 0;
+    if (l < G) { pv[i] = __ldcs((const uint4 *)((const uint8_t *)m.q + (size_t)(r0 + i) * (cols >> 1)) + l); ps[i] = __ldg((const unsigned short *)m.s + (size_t)(r0 + i) * G + l); }
+  }
+  for (int i = threadIdx.x; i < (cols >> 4); i += WPB * 32) { sx[i] = ((const int4 *)a.xq)[i]; if (a.np == 2) sl[i] = ((const int4 *)(a.xq + PLANE))[i]; }
+  for (int i = threadIdx.x; i < G; i += WPB * 32) { sxs[i] = a.xs[i]; sxsum[i] = a.xsum[i]; }
+  __syncthreads();
+  const bool act = l < G; LaneAct la; if (act) la = lane_act(sx, sl, sxs, sxsum, l, a.np);
+#pragma unroll
+  for (int i = 0; i < R; i++) { const float y = q4_dot1(pv[i], ps[i], la, a.np, act); if (l == 0) out[r0 + i] = y; }
+}
